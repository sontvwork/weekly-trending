# Cấu hình KHÔNG bí mật cho Weekly Trending (bash `source`; trending.py tự đọc file này).
# Secret (GCHAT_WEBHOOK_URL) KHÔNG đặt ở đây — xem README.
# Viết dạng hằng số KEY=value / KEY="value" (không dùng `${…:-}`), vì trending.py parse trực tiếp.

# Ngày của bản tin tính theo giờ VN (bash dùng TZ này; Python dùng UTC+7 cố định — VN không có giờ mùa hè).
NEWS_TZ="Asia/Ho_Chi_Minh"
PAGES_BASE_URL="https://sontvwork.github.io/weekly-trending"
TRENDING_URL="https://github.com/trending?since=weekly"
# Branch dữ liệu: workflow Crawl (GitHub Actions) đẩy content/<DATE>/ lên đây, routine `trending.py import` lấy về.
# Proxy GitHub của sandbox cloud chặn github.com/trending (HTTP 403) nên routine không tự crawl được.
DATA_BRANCH="trending-data"

# Số repo lấy từ đầu trang trending (giữ đúng thứ tự trên trang).
TOP_N=10

# Giữ bản tin trên main + site trong RETENTION_WEEKS tuần, tính lùi từ DATE của bản tin đang publish:
# publish.sh (trending.py prune) xoá content/<D>/ và site/<D>/ khi D < DATE − (RETENTION_WEEKS × 7 − 1) ngày.
# guard.sh chỉ cho routine xoá đúng các thư mục đó.
RETENTION_WEEKS=20

# Số ký tự README tối đa lưu vào content/<DATE>/sources/ (đầu vào của sub-agent repo-writer).
README_MAX_CHARS=30000
